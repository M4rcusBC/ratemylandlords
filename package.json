{
  "name": "ratemylandlords",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx @hexclave/cli dev --config-file ./hexclave.config.ts -- npm run dev:inner",
    "dev:inner": "vite",
    "dev:api": "npx @hexclave/cli dev --config-file ./hexclave.config.ts -- npm run dev:api:inner",
    "dev:api:inner": "npm run build && wrangler pages dev",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev",
    "lint": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ratemylandlords --local",
    "db:seed": "tsx scripts/seed-d1.ts"
  },
  "dependencies": {
    "@hexclave/js": "^1.0.125",
    "@hexclave/react": "^1.0.125",
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@tailwindcss/vite": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vite": "^6.3.5",
    "wrangler": "^4.20.5"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.25.12": true
  }
}
